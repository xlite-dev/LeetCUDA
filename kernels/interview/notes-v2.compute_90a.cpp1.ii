  MD val;
  val.m = global_tid < N ? x[global_tid] : -3.40282346638528859811704183484516925e+38F
# 555 "notes-v2.cu"
                                                  ;
  val.d = global_tid < N ? 1.0f : 0.0f;


  __attribute__((shared)) MD shared[WARP_NUM];
  MD res = warp_reduce_md_op<32>(val);

  if (lane_id == 0)
    shared[warp_id] = res;
  __syncthreads();



  if (local_tid < 32) {
    MD block_res =
        local_tid < WARP_NUM ? shared[local_tid] : MD{-3.40282346638528859811704183484516925e+38F
# 570 "notes-v2.cu"
                                                             , 0.0f};
    block_res = warp_reduce_md_op<WARP_NUM>(block_res);
    if (local_tid == 0) {
      shared[0] = block_res;
    }
  }
  __syncthreads();


  MD final_res = shared[0];
  float d_total_inverse = __fdividef(1.0f, final_res.d);

  if (global_tid < N) {
    y[global_tid] = __expf(x[global_tid] - final_res.m) * d_total_inverse;
  }
}
