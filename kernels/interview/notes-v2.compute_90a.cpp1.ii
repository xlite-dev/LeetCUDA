# 184 "notes-v2.cu"
template <const int kWarpSize = 32, typename T = float>
__attribute__((device)) __inline__ __attribute__((always_inline)) T warp_reduce_sum(T val) {
#pragma unroll
  for (int mask = kWarpSize >> 1; mask >= 1; mask >>= 1) {
    val += __shfl_xor_sync(0xffffffff, val, mask, kWarpSize);
  }
  return val;
}


template <const int kWarpSize = 32, typename T = float>
__attribute__((device)) __inline__ __attribute__((always_inline)) T warp_reduce_max(T val) {
#pragma unroll
  for (int mask = kWarpSize >> 1; mask >= 1; mask >>= 1) {
    val = max(val, __shfl_xor_sync(0xffffffff, val, mask, kWarpSize));
  }
