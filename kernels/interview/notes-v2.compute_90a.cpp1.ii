__attribute__((global)) void sgemv_k32(float *a, float *x, float *y, int M, int K) {
  int tx = threadIdx.x;
  int ty = threadIdx.y;
  int bx = blockIdx.x;
  int lane = tx % 32;
  int m = bx * blockDim.y + ty;
  if (m < M) {
    float sum = 0.0f;


    const int NUM_ITERS = (K + 32 - 1) / 32;
#pragma unroll
    for (int w = 0; w < NUM_ITERS; ++w) {

      int k = w * 32 + lane;
      sum += a[m * K + k] * x[k];
    }
    sum = warp_reduce_sum<32>(sum);

    if (lane == 0)
      y[m] = sum;
  }
}







__attribute__((global)) void sgemv_k128(float *a, float *x, float *y, int M, int K) {
  int tx = threadIdx.x;
  int ty = threadIdx.y;
  int bx = blockIdx.x;
  int lane = tx % 32;
  int m = blockDim.y * bx + ty;

  if (m < M) {
    float sum = 0.0f;

    const int NUM_ITERS = (((K + 32 - 1) / 32) + 4 - 1) / 4;
#pragma unroll
    for (int w = 0; w < NUM_ITERS; ++w) {
      int k = (w * 32 + lane) * 4;
      float4 reg_x = (reinterpret_cast<float4 *>(&(x[k]))[0]);
      float4 reg_a = (reinterpret_cast<float4 *>(&(a[m * K + k]))[0]);
      sum += (reg_a.x * reg_x.x + reg_a.y * reg_x.y + reg_a.z * reg_x.z +
              reg_a.w * reg_x.w);
    }
    sum = warp_reduce_sum<32>(sum);
    if (lane == 0)
      y[m] = sum;
  }
}
