             sizeof(half));
    asm volatile( "cp.async.cg.shared.global.L2::128B [%0], [%1], %2;\n" ::"r"(load_smem_b_ptr), "l"(&B[load_gmem_b_addr]), "n"(16));

    asm volatile("cp.async.commit_group;\n" ::);
  }

  const int NUM_K_TILES = div_ceil(K, BK);
