__attribute__((global)) void __attribute__((launch_bounds(256)))
    hgemm_mma_stages_tn(half *A, half *B, half *C, int M, int N, int K) {

  const int bx = ((int)BLOCK_SWIZZLE) * blockIdx.z * gridDim.x + blockIdx.x;
  const int by = blockIdx.y;
  constexpr int BM = MMA_M * MMA_TILE_M * WARP_TILE_M;
  constexpr int BN = MMA_N * MMA_TILE_N * WARP_TILE_N;
  constexpr int BK = MMA_K;






  extern __attribute__((shared)) half smem[];
  half *s_a = smem;
