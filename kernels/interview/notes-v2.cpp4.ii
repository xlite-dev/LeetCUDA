      asm volatile("ldmatrix.sync.aligned.x2.m8n8.shared.b16 {%0, %1}, [%2];\n" : "=r"(RB[j][0]), "=r"(RB[j][1]) : "r"(lane_smem_b_ptr));
    }


#pragma unroll
    for (int i = 0; i < WARP_TILE_M; ++i) {
