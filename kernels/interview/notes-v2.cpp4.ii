static inline void check(cudaError_t err, const char *msg) {
  if (err != cudaSuccess) {
    fprintf(
# 2654 "notes-v2.cu" 3 4
           stderr
# 2654 "notes-v2.cu"
                 , "[ERROR] %s: %s\n", msg, cudaGetErrorString(err));
