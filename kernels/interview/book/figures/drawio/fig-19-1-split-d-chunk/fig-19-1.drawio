ll><mxCell value="c7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=12.5;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="984" y="136" width="106" height="36" as="geometry"/></mxCell><mxCell value="chunk c = 64 个 f16 宽 = 恰好 1 个 SW128 swizzle atom" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="180" width="1072" height="20" as="geometry"/></mxCell><mxCell value="Phase 1  QK^T：S[64,64] += Q(c) @ K(c)^T，c = 0..7 —— 点积内部精确求和，无权重（共享同一个 S acc）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=13;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="212" width="1072" height="46" as="geometry"/></mxCell><mxCell value="Phase 2  softmax(S)：m，l，p = exp2(S*scale - m) —— 与 D 无关" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=13;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="266" width="1072" height="46" as="geometry"/></mxCell><mxCell value="Phase 3  PV：O_c[64,64] *= rho；O_c += P @ V(c)，c = 0..7 —— C 个独立 O acc，同一 rho 广播到全部" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=13;fontColor=#d97706;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="320" width="1072" height="46" as="geometry"/></mxCell><mxCell value="Epi：O_c /= l（c = 0..7）-&gt; 以 (q_tile, c) 为坐标 store [64,64] tile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#486581;fontSize=13;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="374" width="1072" height="42" as="geometry"/></mxCell><mxCell value="流水槽位（TMA 版，Sk = Sv = 2）：" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="428" width="1072" height="24" as="geometry"/></mxCell><mxCell value="idx = kv_tile * C + c；stage = idx % Sk；phase = (idx / Sk) &amp; 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#486581;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="456" width="700" height="46" as="geometry"/></mxCell><mxCell value="D=128（C=2）：phase 周期 1 个 kv_tile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="748" y="456" width="348" height="46" as="geometry"/></mxCell><mxCell value="D=192（C=3）：周期 2（gcd(C,Sk)=1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="748" y="510" width="348" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>