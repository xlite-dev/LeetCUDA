erticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="432" y="476" width="688" height="18" as="geometry"/></mxCell><mxCell value="本 warp tile sum × 1/(v_s·448) 写 sum 段（发布留给步骤③）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="432" y="498" width="688" height="18" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="420" y="556" width="712" height="96" as="geometry"/></mxCell><mxCell value="step 3 · 搭便车（P roundtrip barrier）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="432" y="564" width="688" height="18" as="geometry"/></mxCell><mxCell value="P 写读 SMEM roundtrip 自带的 syncthreads 顺带发布 sum 写" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="432" y="586" width="688" height="18" as="geometry"/></mxCell><mxCell value="finalize_row_sum_m4n2：ℓ = ℓ·scale + Σ(自己, peer)——省 2 次 barrier" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="432" y="608" width="688" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>