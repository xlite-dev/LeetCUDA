y x="40" y="380" width="330" height="56" as="geometry"/></mxCell><mxCell value="两段分置：sum 写与 peer max 读无同步，&#10;合一块 = 偶发 RAW 覆写" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#dc2626;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="442" width="336" height="34" as="geometry"/></mxCell><mxCell value="一致性契约（违反即 O 列段错位）：" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="492" width="340" height="20" as="geometry"/></mxCell><mxCell value="max 合并：m = max(m_C0, m_C1)（顺序无关）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="514" width="340" height="20" as="geometry"/></mxCell><mxCell value="sum 合并：ℓ = ℓ_C0 + ℓ_C1（舍入级差异）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="534" width="340" height="20" as="geometry"/></mxCell><mxCell value="lse 只由 n_warp==0 写（共享 Q 行，L970）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="554" width="340" height="20" as="geometry"/></mxCell><mxCell value="writer = lane%4==0；row_local = lane/4+8r" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="574" width="340" height="20" as="geometry"/></mxCell><mxCell value="fp8 变体：offset=log2(v_s·448) 折 exp2" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2171b5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="594" width="340" height="20" as="geometry"/></mxCell><mxCell value="tile sum 先 ×1/(v_s·448) 再入 sum 段" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2171b5;fontFamily=Helvetica" vertex="1" parent="1">