lue="-> row m+3" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#2171b5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="740" y="104" width="240" height="16" as="geometry"/></mxCell><mxCell value="block(32,4) = 4 warps，one block covers 4 rows" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="560" y="124" width="500" height="18" as="geometry"/></mxCell><mxCell value="k32（K = 32 * NUM-ITERS）：lane l 取 k = 32*w + l" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="158" width="600" height="20" as="geometry"/></mxCell><mxCell value="pass w=0:  lane0 lane1 ... lane31 -> k = 32*0+l" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=12.5;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="60" y="184" width="440" height="34" as="geometry"/></mxCell><mxCell value="x[0] ... x[31]，每 lane 串行累加 sum += a[m][k] * x[k]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="70" y="220" width="430" height="16" as="geometry"/></mxCell><mxCell value="pass w=1:  lane0 lane1 ... lane31 -> k = 32*1+l" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9eff6;strokeColor=#2171b5;fontSize=12.5;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="530" y="184" width="440" height="34" as="geometry"/></mxCell><mxCell value="x[32] ... x[63]，每 lane 串行累加 sum += a[m][k] * x[k]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="540" y="220" width="430" height="16" as="geometry"/></mxCell><mxCell value="累加完成后 5 步 XOR 蝶形归约 -> lane 0 写 y[m]" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="60" y="244" width="900" height="18" as="geometry"/></mxCell><mxCell value="k16（K=16，kRowPerWarp=2）：段宽 16，两行各 16 lane" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="286" width="600" height="20" as="geometry"/></mxCell><mxCell value="lane 0..15 -> row m   (k = lane mod 16)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=12.5;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="60" y="312" width="440" height="30" as="geometry"/></mxCell><mxCell value="lane 16..31 -> row m+1 (k = lane mod 16)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=12.5;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="510" y="312" width="440" height="30" as="geometry"/></mxCell><mxCell value="reduce 小于 16 的 mask 序列 8,4,2,1；row-major A 中 m 与 m+1 行连续 -> 32 lane 仍是 1 个 128B 合并事务；k128 变体：单行 float4 加宽（4 lane 一组）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="60" y="350" width="950" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>