y"/></mxCell><mxCell value="MD 蝶形归约：" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="764" y="180" width="296" height="30" as="geometry"/></mxCell><mxCell value="  d = d1 + d2 * e^(m2-m1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="764" y="214" width="296" height="30" as="geometry"/></mxCell><mxCell value="  m, d 同步重标定" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="764" y="248" width="296" height="30" as="geometry"/></mxCell><mxCell value="y = e^(x-m) / d，1 次 sync" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="764" y="282" width="296" height="30" as="geometry"/></mxCell><mxCell value="箭头方向 = 演进：读 gmem 次数 3 -> 2 -> 1；溢出风险 -> 无；block sync 3 -> 2 -> 1（fast math：expf / __fdividef）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="30" y="372" width="1000" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>