214" width="296" height="30" as="geometry"/></mxCell><mxCell value="3 次 gmem 全量读" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="64" y="248" width="296" height="30" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#627d98;strokeWidth=3;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="380" y="180" as="sourcePoint"/><mxPoint x="402" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell value="safe / Level 2（2-pass）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#d97706;fontSize=14.5;fontColor=#d97706;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="400" y="60" width="320" height="40" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="400" y="104" width="320" height="246" as="geometry"/></mxCell><mxCell value="gmem x -> regs（第 1 次读）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="414" y="112" width="296" height="30" as="geometry"/></mxCell><mxCell value="block reduce max -> m" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="414" y="146" width="296" height="30" as="geometry"/></mxCell><mxCell value="gmem x 第 2 次读（L1 命中）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="414" y="180" width="296" height="30" as="geometry"/></mxCell><mxCell value="e^(x-m) 不超 1，无溢出" style="text;html=1;align=left;verticalAlign=middle;fontSiz