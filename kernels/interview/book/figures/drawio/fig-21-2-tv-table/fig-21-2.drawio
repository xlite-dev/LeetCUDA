))" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="600" y="152" width="520" height="26" as="geometry"/></mxCell><mxCell value="layout_tv : ((_2,_2),_2):((_4,_1),_2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="600" y="184" width="520" height="26" as="geometry"/></mxCell><mxCell value="tiler     : (_2,_4) -&gt; 2 rounds" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="600" y="216" width="520" height="26" as="geometry"/></mxCell><mxCell value="tvS(t,v)  : m = t/2；n = 2*(t%2) + v" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="600" y="248" width="520" height="26" as="geometry"/></mxCell><mxCell value="tvS 公式与左表逐格一致（8 个 (t,v) 逐点核对）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="280" width="520" height="20" as="geometry"/></mxCell><mxCell value="MN-layout（数据视角）：t = 2*m + (n/2)，v = n%2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=13;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="330" width="542" height="56" as="geometry"/></mxCell><mxCell value="TV-layout（任务视角）：m = t/2，n = 2*(t%2) + v" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=13;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="618" y="330" width="542" height="56" as="geometry"/></mxCell><mxCell value="&lt;-&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#486581;fontFamily=Helvetica;f