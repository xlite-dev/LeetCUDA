1 .. Tc   （外层循环流式扫 KV，每块一遍）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9e2ec;strokeColor=#486581;fontSize=14;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="126" width="1036" height="34" as="geometry"/></mxCell><mxCell value="K^[j] [Bc,d]  --(cp.async / TMA)--&gt;  smem" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="170" width="600" height="42" as="geometry"/></mxCell><mxCell value="(3a) load" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#2171b5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="660" y="170" width="400" height="42" as="geometry"/></mxCell><mxCell value="S^[j] = Q K^[j]^T / sqrt(d)     [Br x Bc]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="222" width="600" height="42" as="geometry"/></mxCell><mxCell value="(3b) QK^T -&gt; R_S" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#2171b5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="660" y="222" width="400" height="42" as="geometry"/></mxCell><mxCell value="m_new = max(m, rowmax(S^[j]))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="274" width="600" height="42" as="geometry"/></mxCell><mxCell value="(3c) online" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="660" y="274" width="400" height="42" as="geometry"/></mxCell><mxCell value="P^[j] = exp(S^[j] - m_new)     [Br x Bc]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="326" width="600" height="42" as="geometry"/></mxCell><mxCell value="softmax：P 原地写回 R_S" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="660" y="326" width="400" height="42" as="geometry"/></mxCell><mxCell value="l_new = exp(m - m_new) * l + rowsum(P^[j])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="378" width="600" height="42" as="geometry"/></mxCell><mxCell value="PV = P^[j] V^[j]     [Br x d]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="430" width="600" height="42" as="geometry"/></mxCell><mxCell value="(3d) PV" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#d97706;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="660" y="430" width="400" height="42" as="geometry"/></mxCell><mxCell value="O &lt;- diag(exp(m - m_new)) * O + PV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="482" width="600" height="42" as="geometry"/></mxCell><mxCell value="(3e) rescale" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#d97706;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="660" y="482" width="400" height="42" as="geometry"/></mxCell><mxCell value="" style="endArrow=none;html=1;strokeColor=#9aa5b1;strokeWidth=1.5;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="340" y="172" as="sourcePoint"/><mxPoint x="340" y="526" as="targetPoint"/></mxGeometry></mxCell><mxCell value="循环结束后：O &lt;- O / l    （全程只做一次最终除法）(8) epilogue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=14;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="548" width="1036" height="42" as="geometry"/></mxCell><mxCell value="N x N 矩阵 S 从不存在：任意时刻只有 [Br x Bc] tile 活在 R_S 寄存器里" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=14;fontColor=#7c3a06;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="598" width="1036" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>