 K 敏感性」探针" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf6f6;strokeColor=#f3c1c1;fontSize=11;fontColor=#dc2626;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="562" width="510" height="74" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="592" y="456" width="548" height="190" as="geometry"/></mxCell><mxCell value="epilogue（kv 循环后）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="608" y="464" width="520" height="20" as="geometry"/></mxCell><mxCell value="finalize&#10;÷ row_sum（0 行守卫）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=11;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="608" y="488" width="160" height="40" as="geometry"/></mxCell><mxCell value="+ v_m 加回&#10;（smooth-V 恒等）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6a51a3;fontSize=11;fontColor=#6a51a3;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="790" y="488" width="160" height="40" as="geometry"/></mxCell><mxCell value="lse 写出&#10;（式 32-lse）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=11;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="972" y="488" width="152" height="40" as="geometry"/></mxCell><mxCell value="named barrier（WAR）→ SM90_U32x2_STSM_N 进 SW128&#10;（叠 Q/K 释放区；blockscale C-fragment 用 U32x2 非 U32x4）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#d9e2ec;fontSize=11;fontColor=#48586a;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="608" y="538" width="516" height="40" as="geometry"/></mxCell><mxCell value="→ 单条 TMA store（BHND / NHD 双布局，运行时选坐标）&#10;tail Q tile：R→G 带行守卫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#d9e2ec;fontSize=11;fontColor=#48586a;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="608" y="584" width="516" height="40" as="geometry"/></mxCell><mxCell value="五步环环相扣：③ 的 π 与 ② 的 C 布局、⑤ 的 A 布局三方锁定（SA3 adapter 逐字拷贝的自洽体系）。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="668" width="1110" height="20" as="geometry"/></mxCell><mxCell value="吞吐参考：D=192 self 474T（fp4 基线）；MXFP8 PV 变体 357T（精度保险丝，D≤192）。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="692" width="1110" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
