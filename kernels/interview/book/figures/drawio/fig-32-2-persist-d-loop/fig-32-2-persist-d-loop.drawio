<mxfile host="app.diagrams.net"><diagram id="fig32-2" name="fig32-2"><mxGraphModel dx="800" dy="600" grid="0" page="1" pageWidth="1160" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell value="fp4 persist-D 主循环：128T producer + 256T consumer 与每 tile 五步" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="8" width="1110" height="30" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="46" width="1110" height="66" as="geometry"/></mxCell><mxCell value="work loop：for (work_id = blockIdx.x; work_id &lt; total_work; work_id += gridDim.x)   // 单 kernel 单路径，runtime grid 定风格" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1070" height="20" as="geometry"/></mxCell><mxCell value="dense：grid = min(total_work, SMs)，persistent，流水摊一次、跨 work 预取" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="76" width="520" height="28" as="geometry"/></mxCell><mxCell value="causal：grid = total_work，block-per-work，短 work 早完早释放（多数 Tc_eff ≪ Tc）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="600" y="76" width="520" height="28" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7faf7;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="130" width="250" height="300" as="geometry"/></mxCell><mxCell value="producer（128T）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="138" width="220" height="20" as="geometry"/></mxCell><mxCell value="TMA 装载&#10;K/SFK · Vᵀ/SFVt · ΔS · bias" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=11;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="166" width="218" height="44" as="geometry"/></mxCell><mxCell value="Q/SFQ TMA（每 work）&#10;epilogue_done 后才发" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=11;fontColor=#102a43;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="222" width="218" height="44" as="geometry"/></mxCell><mxCell value="等待 k_empty / v_empty&#10;（stage 释放信号）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=11;fontColor=#102a43;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="278" width="218" height="44" as="geometry"/></mxCell><mxCell value="反向 barrier 全集：&#10;k_empty[s] · v_empty[s]（256 arrivals）&#10;q_consumed · epilogue_done&#10;mbarrier 永不 re-init：&#10;全局 kv-tile 计数器驱动 phase" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7faf7;strokeColor=#d9e2ec;fontSize=10;fontColor=#48586a;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="332" width="218" height="84" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="296" y="130" width="190" height="300" as="geometry"/></mxCell><mxCell value="smem stages" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica;fontStyle