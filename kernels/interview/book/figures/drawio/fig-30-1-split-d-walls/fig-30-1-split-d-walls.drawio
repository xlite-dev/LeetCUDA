<mxfile host="app.diagrams.net"><diagram id="fig-30-1" name="fig-30-1"><mxGraphModel dx="800" dy="600" grid="0" page="1" pageWidth="1180" pageHeight="754" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell value="大 D 的两堵墙与 dispatch 三分路由（dispatch/cute_fp8.cuh L60-64）" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="8" width="1132" height="30" as="geometry"/></mxCell><mxCell value="① D 轴三分（fp8 家族，fp16/fp4 同构）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="60" width="300" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="86" width="250" height="66" as="geometry"/></mxCell><mxCell value="persist-D  D≤224" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#2171b5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="90" width="238" height="22" as="geometry"/></mxCell><mxCell value="WS 128P+256C · O=D/2" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="30" y="116" width="238" height="30" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="274" y="86" width="420" height="66" as="geometry"/></mxCell><mxCell value="split-D M8N1  224<D<768" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="280" y="90" width="408" height="22" as="geometry"/></mxCell><mxCell value="kBr/kBc=128/128 · non-WS 256T · O=D/2" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="280" y="116" width="408" height="30" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="644" y="86" width="480" height="66" as="geometry"/></mxCell><mxCell value="split-D M4N2  D≥768" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#d97706;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="650" y="90" width="468" height="22" as="geometry"/></mxCell><mxCell value="kBr/kBc=64/64 · non-WS 256T · O=D/4" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="650" y="116" width="468" height="30" as="geometry"/></mxCell><mxCell value="" style="endArrow=none;html=1;strokeColor=#102a43;strokeWidth=2;rounded=0;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="644" y="74" as="sourcePoint"/><mxPoint x="644" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell value="交叉点 D=768" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="644" y="56" width="160" height="18" as="geometry"/></mxCell><mxCell value="" style="endArrow=none;html=1;strokeColor=#9fb3c8;strokeWidth=1;rounded=0;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="274" y="74" as="sourcePoint"/><mxPoint x="274" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe5e5;strokeColor=#dc2626;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="190" width="540" height="170" as="geometry"/></mxCell><mxCell value="墙一 smem：K tile 字节 = Bc×D×1B，O(D)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="198" width="508" height="22" as="geometry"/></mxCell><mxCell value="D=512、Bc=128 → K tile 64KB；加 V stage + Q 即超 99KB 预算" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="226" width="508" height="20" as="geometry"/></mxCell><mxCell value="persist-D 的 K stage-0 复用只在 D≤224 挤得过" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="250" width="508" height="20" as="geometry"/></mxCell><mxCell value="整块 K tile 一次进 smem&#10;（persist-D：D≤224 专属）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;fontSize=12;fontColor=#102a43;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="278" width="240" height="62" as="geometry"/></mxCell><mxCell value="split-D：D 切 chunk 流水&#10;每 stage 与总 D 无关" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=12;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="300" y="278" width="240" height="62" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#2e8540;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="280" y="309" as="sourcePoint"/><mxPoint x="300" y="309" as="targetPoint"/></mxGeometry></mxCell><mxCell value="chunk_index = kv_tile·kDChunks + c，stage/phase 环形推进" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="344" width="508" height="14" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6a51a3;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="190" width="560" height="170" as="geometry"/></mxCell><mxCell value="墙二 寄存器：O 累加器 = D/(2N_w) f32/线程" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#6a51a3;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="612" y="198" width="528" height="22" as="geometry"/></mxCell><mxCell value="M8N1 单 warp 独占整 D 列：D=512 → 256 regs 压线（上限 255）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="612" y="226" width="528" height="20" as="geometry"/></mxCell><mxCell value="D≥896 大量 spill 崩塌（D=1024 实测 ~100T）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="612" y="250" width="528" height="20" as="geometry"/></mxCell><mxCell value="M8N1 (8,1,1)：O=D/2&#10;D=1024 → 512 regs 溢出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6a51a3;fontSize=12;fontColor=#102a43;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="612" y="278" width="250" height="62" as="geometry"/></mxCell><mxCell value="M4N2 (4,2,1)：O=D/4&#10;D=1024 → 256 regs 边缘 spill 154T" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontSize=12;fontColor=#8a4b08;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="882" y="278" width="250" height="62" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#d97706;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="862" y="309" as="sourcePoint"/><mxPoint x="882" y="309" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="396" width="1132" height="150" as="geometry"/></mxCell><mxCell value="② 寄存器压力模型：N_w 消去，只有减 M_w 有效" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="404" width="1100" height="22" as="geometry"/></mxCell><mxCell value="per-thread：O_acc = 4·(kBr/16M_w)·(D/8N_w)/(kBr/16M_w) = D/(2N_w)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="436" width="640" height="20" as="geometry"/></mxCell><mxCell value="per-SM 池占比：[D/(2N_w)] / [65536/(32M_wN_w)] = D·M_w/4096" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6a51a3;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="462" width="640" height="20" as="geometry"/></mxCell><mxCell value="N_w 精确消去：M4N4 ≡ M4N2（同为 D/1024）；M2N4 → D/2048 是 D>1024 正解" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="488" width="640" height="20" as="geometry"/></mxCell><mxCell value="" style="endArrow=none;html=1;strokeColor=#9fb3c8;strokeWidth=1;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="696" y="436" as="sourcePoint"/><mxPoint x="696" y="526" as="targetPoint"/></mxGeometry></mxCell><mxCell value="被否决的捷径①：QK M8N1 + PV M4N2 混合布局" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="712" y="452" width="428" height="18" as="geometry"/></mxCell><mxCell value="QK/PV 共享 Q tile，M 维须一致：&#10;kBr=128 → PV 仍 D/2&#10;kBr=64 → M8N1 空 4 warp" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="712" y="470" width="428" height="50" as="geometry"/></mxCell><mxCell value="被否决的捷径②：WS 版 split-D" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="712" y="500" width="428" height="18" as="geometry"/></mxCell><mxCell value="setmaxnreg 上限 232 装不下 D=512 的 256-reg O" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="712" y="518" width="428" height="16" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="576" width="1132" height="150" as="geometry"/></mxCell><mxCell value="③ 实测交叉点（5090，fp16 同构；PRO 5000 数据见正文 30.6）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1e5631;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="584" width="1100" height="22" as="geometry"/></mxCell><mxCell value="D≤640：M8N1 快 +2~16%（无 P roundtrip、kBr 大一倍）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="612" width="540" height="20" as="geometry"/></mxCell><mxCell value="D≥768：M4N2 快 +7%@768、+11%@896、+55%@1024" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="636" width="540" height="20" as="geometry"/></mxCell><mxCell value="FFPA_FP8_FORCE_KERNEL=split_d|m4n2（224<D≤1024）可强制 A/B" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="660" width="540" height="20" as="geometry"/></mxCell><mxCell value="PRO 5000 实测（本机 headdim 止于 512）：D=512 self 203T / 2.98x" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="684" width="540" height="20" as="geometry"/></mxCell><mxCell value="" style="endArrow=none;html=1;strokeColor=#9fb3c8;strokeWidth=1;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="604" y="612" as="sourcePoint"/><mxPoint x="604" y="704" as="targetPoint"/></mxGeometry></mxCell><mxCell value="split-D 是精确变换：" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="620" y="612" width="520" height="20" as="geometry"/></mxCell><mxCell value="QK 侧 D 是归约维：Σ_c Q_c K_c^T 累加进同一 S（无新舍入点）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="620" y="636" width="520" height="20" as="geometry"/></mxCell><mxCell value="PV 侧 D 是输出列维：各 chunk 的 O 段独立累加" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="620" y="660" width="520" height="20" as="geometry"/></mxCell><mxCell value="softmax 行统计 (m,ℓ) 是 KV 行维的量——与 D 切分无关" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="620" y="684" width="520" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>