<mxfile host="app.diagrams.net"><diagram id="fig9-1" name="fig9-1"><mxGraphModel dx="800" dy="600" grid="0" page="1" pageWidth="1100" pageHeight="530" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell value="grid -> block -> warp -> thread 四级 tiling（C 矩阵视角）" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="14" width="950" height="26" as="geometry"/></mxCell><mxCell value="grid 级：C[M,N] 切成 (M/BM) x (N/BN) 个 block tile" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#2171b5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50" y="56" width="400" height="20" as="geometry"/></mxCell><mxCell value="tile 0,0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=12;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="80" y="82" width="120" height="60" as="geometry"/></mxCell><mxCell value="tile 0,1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=12;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="210" y="82" width="120" height="60" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=12;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="340" y="82" width="120" height="60" as="geometry"/></mxCell><mxCell value="tile 1,0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=12;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="80" y="152" width="120" height="60" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;stroke