 value="row band (tid/32)*1  x  128 cols" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontSize=10.5;fontColor=#8c2f0f;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="580" y="156" width="460" height="20" as="geometry"/></mxCell><mxCell value="thread 级：每线程一个 4 x 4 寄存器 tile（16 输出 sum[4][4]）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50" y="300" width="500" height="20" as="geometry"/></mxCell><mxCell value="n: n0..n0+3  n0=(tid%32)*4" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="80" y="328" width="200" height="18" as="geometry"/></mxCell><mxCell value="tt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=10.5;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="80" y="352" width="34" height="28" as="geometry"/></mxCell><mxCell value="tt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=10.5;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="116" y="352" width="34" height="28" as="geometry"/></mxCell><mxCell value="tt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=10.5;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="152" y="352" width="34" height="28" as="geometry"/></mxCell><mxCell value="tt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=10.5;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="188" y="352" width="34" height="28" as="geometry"/></mxCell><mxCell value="tt" style="rounded=0;whiteSpac