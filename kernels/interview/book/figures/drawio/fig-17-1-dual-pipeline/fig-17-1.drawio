<mxfile host="app.diagrams.net"><diagram id="fig-17-1" name="fig-17-1"><mxGraphModel dx="800" dy="600" grid="0" page="1" pageWidth="1180" pageHeight="616" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell value="producer/consumer 双流水时序（Sk=2, Sv=1, D=64）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1132" height="28" as="geometry"/></mxCell><mxCell value="producer WG0（1 个活跃线程，TMA 提交）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=14;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="50" width="540" height="32" as="geometry"/></mxCell><mxCell value="consumer WG1（8 warps, 256 线程）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=14;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="616" y="50" width="540" height="32" as="geometry"/></mxCell><mxCell value="P0：TMA Q --expect_tx 16KB--&gt; full_Q" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=12.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="92" width="540" height="38" as="geometry"/></mxCell><mxCell value="P1：TMA K[0]-&gt;st0；TMA K[1]-&gt;st1（预取 Sk-1=1 个 tile）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=12.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="138" width="540" height="38" as="geometry"/></mxCell><mxCell value="P2（每轮 k）：TMA V[k]-&gt;v0，随后 TMA K[k+2]-&gt;st（覆盖已被 consumer 释放的空槽）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=12.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="184" width="540" height="60" as="geometry"/></mxCell><mxCell value="producer 领先 consumer 至多 Sk-1 个 K tile / Sv 个 V tile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#2171b5;fontSize=12;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="254" width="540" height="44" as="geometry"/></mxCell><mxCell value="C0：256x arrive empty_K[0..1]；256x arrive empty_V[0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=12.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="616" y="92" width="540" height="38" as="geometry"/></mxCell><mxCell value="wait full_Q（一次，Q 就位）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=12.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="616" y="138" width="540" height="34" as="geometry"/></mxCell><mxCell value="---- iter k = 0 ----" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#1e5631;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="616" y="178" width="540" height="22" as="geometry"/></mxCell><mxCell value="wait full_K[0]：QK 用 K[0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=11.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="626" y="202" width="530" height="34" as="geometry"/></mxCell><mxCell value="3b QK^T：ldmatrix + HMMA ——&gt; arrive empty_K[0]（用完即提前释放）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=11.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="626" y="242" width="530" height="34" as="geometry"/></mxCell><mxCell value="3c softmax（纯寄存器，不碰 smem）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=11.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="626" y="282" width="530" height="34" as="geometry"/></mxCell><mxCell value="wait full_V[0]（恰在 3d 前）—— 3d PV：R_S 复用 + X2_T(V) —— arrive empty_V[0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=11.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="626" y="322" width="530" height="34" as="geometry"/></mxCell><mxCell value="3e rescale（m, l, O）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=11.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="626" y="362" width="530" height="34" as="geometry"/></mxCell><mxCell value="iter k = 1：同构（wait full_K[1] -&gt; QK^T -&gt; softmax -&gt; PV -&gt; rescale）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#2e8540;fontSize=11.5;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="616" y="406" width="540" height="38" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#d97706;strokeWidth=2;rounded=0;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="564" y="214" as="sourcePoint"/><mxPoint x="616" y="214" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#d97706;strokeWidth=2;rounded=0;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="564" y="300" as="sourcePoint"/><mxPoint x="616" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell value="overlap：计算 tile k 与搬运 tile k+1 完全重叠 —— 搬运延迟被计算掩盖" style="rounded=0;whiteS