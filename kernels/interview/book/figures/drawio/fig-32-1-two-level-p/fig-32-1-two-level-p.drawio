<mxfile host="app.diagrams.net"><diagram id="fig32-1" name="fig32-1"><mxGraphModel dx="800" dy="600" grid="0" page="1" pageWidth="1160" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell value="两级 P 量化：online softmax 下的域拉伸与 exp2 折叠" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="8" width="1110" height="30" as="geometry"/></mxCell><mxCell value="① 问题：直接块量化的 SF 窄域浪费（SA3 C2）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="46" width="540" height="20" as="geometry"/></mxCell><mxCell value="P ∈ [0,1]，行内分布剧变：&#10;causal 早行近 one-hot / dense 行小而均匀&#10;→ s = amax(块)/6 ∈ [0, 0.167]&#10;ue4m3 在窄域的有效位数被浪费（SF 自身先损）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe5e5;strokeColor=#dc2626;fontSize=12;fontColor=#dc2626;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="72" width="500" height="90" as="geometry"/></mxCell><mxCell value="② 方案：两级拉伸（SA3 §3.2）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="610" y="46" width="530" height="20" as="geometry"/></mxCell><mxCell value="第一级：整行拉伸到满量程（s_P1 = rowmax/2688）&#10;第二级：per-16 组 absmax 归一（s_P2, ue4m3）&#10;→ 组 amax 恰好铺满 ue4m3 域 [0, 448]&#10;2688 = 448（ue4m3 满）× 6（e2m1 满）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=12;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="610" y="72" width="530" height="90" as="geometry"/></mxCell><mxCell value="③ 域拉伸链（三个域的端点）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="186" width="1110" height="20" as="geometry"/></mxCell><mxCell value="softmax 输出（已减行 max）&#10;值域 [0, 1]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9fb3c8;fontSize=12;fontColor=#102a43;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="212" width="300" height="46" as="geometry"/></mxCell><mxCell value="P₂ = P̃ × 2688&#10;值域 [0, 2688]（全局常数拉伸）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6a51a3;fontSize=12;fontColor=#6a51a3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="400" y="212" width="320" height="46" as="geometry"/></mxCell><mxCell value="P̂₂ ∈ (0, 6]（e2m1 数据）&#10;s_P2 ∈ (0, 448]（ue4m3 组 SF）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=12;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="800" y="212" width="340" height="46" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#6a51a3;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="324" y="235" as="sourcePoint"/><mxPoint x="400" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#2e8540;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="720" y="235" as="sourcePoint"/><mxPoint x="800" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell value="×2688" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6a51a3;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="322" y="240" width="76" height="34" as="geometry"/></mxCell><mxCell value="÷s_P2" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="726" y="240" width="72" height="34" as="geometry"/></mxCell><mxCell value="还原：O = FP4MM(P̂₂, s_P2, V̂, s_V) —— 2688 在 O 与 row_sum 同现，finalize 相除精确消去" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="266" width="1110" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="300" width="540" height="220" as="geometry"/></mxCell><mxCell value="④ 实现的红利：第一级退化成常数" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="308" width="510" height="20" as="geometry"/></mxCell><mxCell value="online softmax 先减运行行 max ⇒&#10;rowmax(P̃) ≡ 1 ⇒ s_P1 ≡ 1/(448×6)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a51a3;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="334" width="510" height="40" as="geometry"/></mxCell><mxCell value="P₂ = exp2(S·L − m·L + log2(1/2688)) ∈ [0, 2688]&#10;s_P2 = exp2(a·L − m_sc + log2(1/6)) ∈ (0, 448]&#10;（L = scale·log2e；编译期常数 −11.392 / −2.585）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#d9e2ec;fontSize=11;fontColor=#48586a;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="384" width="510" height="60" as="geometry"/></mxCell><mxCell value="逐行的 s_P1 存储与乘回全部消失" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="452" width="510" height="20" as="geometry"/></mxCell><mxCell value="组归一也折进 exp2：q = exp2((s−a)·L + log2 6)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="476" width="510" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="592" y="300" width="250" height="220" as="geometry"/></mxCell><mxCell value="⑤ 同链双归约" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="608" y="308" width="220" height="20" as="geometry"/></mxCell><mxCell value="lane 持 8 元素&#10;组 = 2 lane × 8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9fb3c8;fontSize=11;fontColor=#102a43;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="608" y="336" width="218" height="40" as="geometry"/></mxCell><mxCell value="shfl_xor(1)&#10;→ 16 元素组 absmax" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=11;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="608" y="388" width="218" height="40" as="geometry"/></mxCell><mxCell value="shfl_xor(2)&#10;→ quad 内行 max" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=11;fontColor=#8a4b08;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="608" y="440" width="218" height="40" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#102a43;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="717" y="376" as="sourcePoint"/><mxPoint x="717" y="388" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#102a43;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="717" y="428" as="sourcePoint"/><mxPoint x="717" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell value="组尺度+行 max 冗余减半" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="608" y="488" width="220" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="870" y="300" width="270" height="220" as="geometry"/></mxCell><mxCell value="⑥ 三个守卫" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="886" y="308" width="240" height="20" as="geometry"/></mxCell><mxCell value="全 masked 组：clamp 防 NaN" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#dc2626;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="886" y="334" width="240" height="20" as="geometry"/></mxCell><mxCell value="InfCheck：全 masked 行守卫" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#dc2626;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="886" y="384" width="240" height="20" as="geometry"/></mxCell><mxCell value="FirstTile：−∞ 重启防泄漏" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#dc2626;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="886" y="434" width="240" height="20" as="geometry"/></mxCell><mxCell value="ex2.approx.ftz.f32 单 MUFU" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="886" y="484" width="240" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="546" width="540" height="100" as="geometry"/></mxCell><mxCell value="⑦ lazy rescale（PC-11 per-row 守卫）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="552" width="510" height="20" as="geometry"/></mxCell><mxCell value="跨 tile 行 max 更新不即时重乘 O；下一个 PV 累加前&#10;scores_scale(mi) &lt; 1.0f 的行才补乘（dense 96.5% 命中零 FMUL），&#10;FMUL 永不无守卫进入 MMA 依赖链" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#d9e2ec;fontSize=11;fontColor=#48586a;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="576" width="510" height="60" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="592" y="546" width="548" height="100" as="geometry"/></mxCell><mxCell value="⑧ MXFP8 PV 变体的域常量切换" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="608" y="552" width="520" height="20" as="geometry"/></mxCell><mxCell value="Vᵀ 换 e4m3 + ue8m0（32 组）时：P 侧同换 32 粒度，&#10;域常量 2688 → 448（无 e2m1 因子）、SF 取 2 的幂；&#10;历史 latent bug：lse 无条件沿用 2688（差 ln 6）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#d9e2ec;fontSize=11;fontColor=#48586a;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="608" y="576" width="520" height="60" as="geometry"/></mxCell><mxCell value="口诀：两级量化在实现里只剩一组组 absmax——第一级被 online softmax 折成常数，第二级的除法被 exp2 参数吸收。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a51a3;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="662" width="1110" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
