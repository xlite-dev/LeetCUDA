width="1072" height="18" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe5e5;strokeColor=#dc2626;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="248" width="540" height="236" as="geometry"/></mxCell><mxCell value="方案 A：ReorgC8bitToA8bit（跨 lane，历史默认）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="254" width="508" height="22" as="geometry"/></mxCell><mxCell value="每线程每 128 列 tile：16× __shfl_sync + 32× __byte_perm" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="280" width="508" height="20" as="geometry"/></mxCell><mxCell value="选择性 selector 按 lane%4 分叉（构造器状态 + 分支）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="304" width="508" height="20" as="geometry"/></mxCell><mxCell value="对 peer lane 的字节做 quad 内交换（peer map 2-bit 压缩）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="328" width="508" height="20" as="geometry"/></mxCell><mxCell value="代价：全部落在 QK→softmax→PV 关键路径上" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="358" width="508" height="22" as="geometry"/></mxCell><mxCell value="split-D 家族仍在使用（kBc 结构不同，未迁移）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="384" width="508" height="20" as="geometry"/></mxCell><mxCell value="V^T 存储无需置换（自然列序）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="420" width="508" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="600" y="248" width="536" height="236" as="geometry"/></mxCell><mxCell value="方案 B：PackC8bitToA8bitPermVT（reorg-free，默认）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1e5631;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="616" y="254" width="504" height="22" as="geometry"/></mxCell><mxCell value="数学：Σ_k P[m,k]V[k,n] 对任意双射 π 不变 —— P 不动，V 搬家" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="616" y="280" width="504" height="20" as="geometry"/></mxCell><mxCell value="就地打包：4× __byte_perm（0x5410/0x7632/0xDC98/0xFEBA）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="616" y="304" width="504" height="20" as="geometry"/></mxCell><mxCell value="selector 与 lane 无关：无构造器状态、无分支" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="616" y="328" width="504" height="20" as="geometry"/></mxCell><mxCell value="A 槽位 s 携带置换索引 π(s) = 8(r>>1)+2t+(r&amp;1)（32 列周期）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1e5631;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="616" y="358" width="504" height="22" as="geometry"/></mxCell><mxCell value="V^T 按 π⁻¹(j)=4*((j>>1)&amp;3)+2*((j>>3)&amp;1)+(j&amp;1) 预置换列写" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="616" y="384" width="504" height="20" as="geometry"/></mxCell><mxCell value="置换不跨 32 列组 → V^T 写仍同一 32B sector（quantize +0.5%）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="616" y="420" width="504" height="20" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#102a43;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="564" y="366" as="sourcePoint"/><mxPoint x="600" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6a51a3;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="508" width="1112" height="96" as="geometry"/></mxCell><mxCell value="配对契约（CONTRACT）：pack 与 V^T 置换必须同开同关 —— 由 launcher 单一编译期常量 reorg_free 强制，两侧永不发散" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6a51a3;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="514" width="1072" height="20" as="geometry"/></mxCell><mxCell value="注释原话加感叹号：this pack must NEVER run against an unpermuted V^T —— 错配 = 静默错值（allclose 才能抓到）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="538" width="1072" height="20" as="geometry"/></mxCell><mxCell value="rowsum MMA（B 全 1）与 PV 在双射下同样精确；等效性已 pycute 数值验证（.tmp/fp8_persist_d/verify_layouts.py 同族）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="562" width="1072" height="20" as="geometry"/></mxCell><mxCell value="出处对照：SA2 的 per-warp token 重排思想（arXiv:2411.10958）；ffpa 的数学化重构 = 把跨 lane 搬运转嫁给前处理链的免费列置换" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="624" width="1112" height="20" as="geometry"/></mxCell><mxCell value="拆分规则：K=32 组 = 4 个 n8 C-tile（w0..w3）→ a0={0,1,4,5} a1={2,3,6,7} a2={8,9,12,13} a3={10,11,14,15}（字节序号）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="650" width="1112" height="20" as="geometry"/></mxCell><mxCell value="对照 ffpa-attn(861d75e)：cute/fp8/reg2reg_8b.cuh L8-50（背景+跨 lane 版）· L96-141（perm pack）· quantize_fp8.cuh L36-53（VTPermInv32）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="692" width="1112" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>