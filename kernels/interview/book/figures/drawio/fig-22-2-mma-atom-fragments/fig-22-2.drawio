y="154" width="250" height="18" as="geometry"/></mxCell><mxCell value="fragment 即 mma 指令的寄存器输入" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="890" y="174" width="250" height="18" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bcccdc;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="580" y="272" width="570" height="220" as="geometry"/></mxCell><mxCell value="m16n8k16 f16 atom：每 thread 的 fragment 大小" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="282" width="540" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#deebf7;strokeColor=#2171b5;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="312" width="12" height="42" as="geometry"/></mxCell><mxCell value="A（16×16，M×K）：每 thread 8 值" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#2171b5;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="618" y="310" width="520" height="18" as="geometry"/></mxCell><mxCell value="m 行: a0 a1 a4 a5；m+8 行: a2 a3 a6 a7" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="618" y="330" width="530" height="18" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dff0e2;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="360" width="12" height="42" as="geometry"/></mxCell><mxCell value="B（16×8，K×N）：每 thread 4 值" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#2e8540;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="618" y="358" width="520" height="18" as="geometry"/></mxCell><mxCell value="n 列固定；k 行: b0 b1，k+8 行: b2 b3" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="618" y="378" width="530" height="18" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdeadb;strokeColor=#d97706;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="408" width="12" height="42" as="geometry"/></mxCell><mxCell value="C/D（16×8，M×N）：每 thread 4 值" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#d97706;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="618" y="406" width="520" height="18" as="geometry"/></mxCell><mxCell value="即左图布局：m 行: c0 c1，m+8 行: c2 c3" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="618" y="426" width="530" height="18" as="geometry"/></mxCell><mxCell value="守恒：32×(8+4+4) = 512 值 = 256+128+128，恰为 A+B+C 全部元素" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="462" width="545" height="18" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dff0e2;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="580" y="508" width="570" height="188" as="geometry"/></mxCell><mxCell value="atom = 最小可复制的 MMA 单元" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1e5631;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="518" width="540" height="20" as="geometry"/></mxCell><mxCell value="一条 mma.sync（m16n8k16 f16）由 32 threads 各出一个 fragment，协作算出 16×8 输出" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1e5631;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="546" width="545" height="18" as="geometry"/></mxCell><mxCell value="每 thread：A 8 值 / B 4 值 / C 4 值；D 累加回 C fragment" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1e5631;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="568" width="545" height="18" as="geometry"/></mxCell><mxCell value="tile 更大 = atom 沿 M/N 复制堆叠（见左下），映射规律不变" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1e5631;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="590" width="545" height="18" as="geometry"/></mxCell><mxCell value="CuTe：make_tiled_mma(atom, m, n) 即按复制数生成 TiledMMA" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1e5631;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="596" y="612" width="545" height="18" as="geometry"/></mxCell><mxCell value="atom 复制（tiling）→ 更大的 GEMM tile" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="60" y="474" width="380" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8aa2b8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica;dashed=1" vertex="1" parent="1"><mxGeometry x="96" y="498" width="300" height="124" as="geometry"/></mxCell><mxCell value="atom 16×8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dff0e2;strokeColor=#2e8540;fontSize=11.5;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="108" y="512" width="132" height="48" as="geometry"/></mxCell><mxCell value="atom 16×8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dff0e2;strokeColor=#2e8540;fontSize=11.5;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="252" y="512" width="132" height="48" as="geometry"/></mxCell><mxCell value="atom 16×8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dff0e2;strokeColor=#2e8540;fontSize=11.5;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="108" y="566" width="132" height="48" as="geometry"/></mxCell><mxCell value="atom 16×8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dff0e2;strokeColor=#2e8540;fontSize=11.5;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="252" y="566" width="132" height="48" as="geometry"/></mxCell><mxCell value="2×2 复制 →" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="412" y="512" width="128" height="18" as="geometry"/></mxCell><mxCell value="M32×N16 tile" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="412" y="532" width="128" height="18" as="geometry"/></mxCell><mxCell value="64 threads" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="412" y="552" width="128" height="18" as="geometry"/></mxCell><mxCell value="映射不变" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="412" y="572" width="128" height="18" as="geometry"/></mxCell><mxCell value="TiledMMA 的 atom 数 = (M/16)×(N/8)，每个 atom 内的映射与上图相同" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="60" y="640" width="500" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>