nt = 16 x 7 近方块（同 110 tiles）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="656" y="377" width="400" height="20" as="geometry"/></mxCell><mxCell value="launch 顺序 x -> y -> z 不变，bx 重排实现" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="656" y="399" width="420" height="18" as="geometry"/></mxCell><mxCell value="L2 footprint F（每个 K-slab 的 unique A+B tiles）：F = (H*BM + W*BN) * K * 2B" style="text;html=1;align=left;verticalAlign=middle;fontSize=14.5;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="490" width="900" height="22" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#dc2626;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="520" width="330" height="70" as="geometry"/></mxCell><mxCell value="default：(1*128 + 110*128) * K * 2B" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#8c2f0f;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="56" y="528" width="310" height="24" as="geometry"/></mxCell><mxCell value="= 14208 * K * 2B" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#8c2f0f;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="56" y="556" width="310" height="24" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="400" y="520" width="330" height="70" as="geometry"/></mxCell><mxCell value="swizzle：(7*128 + 16*128) * K * 2B" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#1e5631;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="416" y="528" width="310" height="24" as="geometry"/></mxCell><mxCell value="= 2944 * K * 2B" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1e5631;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="416" y="556" width="310" height="24" as="geometry"/></mxCell><mxCell value="footprint 缩小 4.8x" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#2171b5;fontSize=16;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="760" y="520" width="330" height="70" as="geometry"/></mxCell><mxCell value="实测 L2 sector hit rate：64.45% -> 96.15%，端到端 117.9 -> 122.9 TFLOPS（+4.2%，PRO 5000，2048x16384x4096 HGEMM）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="598" width="1000" height="20" as="geometry"/></mxCell>
