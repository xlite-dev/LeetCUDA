        <mxCell value="block swizzle：C-tile 光栅化前后（L2 footprint 对比）" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="12" width="900" height="26" as="geometry"/></mxCell><mxCell value="T_m=16 x T_n=128，常驻集 R ≈ 110 blocks（110 SM × 1 block/SM），组宽 S=16；resident set = 一个 wave 里同时驻留 SM 的 C-tile 集合" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="30" y="42" width="1000" height="20" as="geometry"/></mxCell><mxCell value="[default] 2D grid：x 最快，行优先光栅" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="96" width="460" height="22" as="geometry"/></mxCell><mxCell value="y=0 一行即被 110 blocks 填满" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#dc2626;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="30" y="118" width="460" height="18" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="80" y="160" width="17" height="17" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="99" y="160" width="17" height="17" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="118" y="160" width="17" height="17" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=