idth="310" height="24" as="geometry"/></mxCell><mxCell value="= 16640 * K * 2B" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#8c2f0f;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="56" y="516" width="310" height="24" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="400" y="480" width="330" height="70" as="geometry"/></mxCell><mxCell value="swizzle：(14*128 + 16*128) * K * 2B" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#1e5631;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="416" y="488" width="310" height="24" as="geometry"/></mxCell><mxCell value="= 3840 * K * 2B" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1e5631;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="416" y="516" width="310" height="24" as="geometry"/></mxCell><mxCell value="footprint 缩小 4.3x" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#2171b5;fontSize=16;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="760" y="480" width="330" height="70" as="geometry"/></mxCell><mxCell value="实测 L2 sector hit rate：64.45% -> 96.15%（PRO 5000，2048x16384x4096 HGEMM）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="558" width="900" height="20" as="geometry"/></mxCell>
