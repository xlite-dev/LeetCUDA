<mxfile host="app.diagrams.net"><diagram id="fig5-1" name="fig5-1"><mxGraphModel dx="800" dy="600" grid="0" page="1" pageWidth="1080" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell value="两个分块 attention 状态的合并 == 整体 softmax 加权（定理 5.1）" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="14" width="950" height="26" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="50" y="60" width="420" height="172" as="geometry"/></mxCell><mxCell value="KV chunk A: s(1..n)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#2171b5;fontSize=14;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50" y="60" width="420" height="32" as="geometry"/></mxCell><mxCell value="m(A) = max s(1..n)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="66" y="100" width="400" height="28" as="geometry"/></mxCell><mxCell value="l(A) = SUM e^(s - m(A))" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="66" y="132" width="400" height="28" as="geometry"/></mxCell><mxCell value="O(A) = SUM e^(s-m(A)) * V / l(A)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="66" y="164" width="400" height="28" as="geometry"/></mxCell><mxCell value="LSE(A) = m(A) + log l(A)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="66" y="196" width="400" height="28" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="610" y="60" width="420" height="172" as="geometry"/></mxCell><mxCell value="KV chunk B: s(n+1..n+m)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#2e8540;fontSize=14;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="610" y="60" width="420" height="32" as="geometry"/></mxCell><mxCell value="m(B) = max s(n+1..n+m)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="626" y="100" width="400" height="28" as="geometry"/></mxCell><mxCell value="l(B) = SUM e^(s - m(B))" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="626" y="132" width="400" height="28" as="geometry"/></mxCell><mxCell value="O(B) = SUM e^(s-m(B)) * V / l(B)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="626" y="164" width="400" height="28" as="geometry"/></mxCell><mxCell value="LSE(B) = m(B) + log l(B)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="626" y="196" width="400" height="28" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#627d98;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="300"/></Array><mxPoint x="260" y="236" as="sourcePoint"/><mxPoint x="500" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#627d98;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="300"/></Array><mxPoint x="820" y="236" as="sourcePoint"/><mxPoint x="580" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f3ec;strokeColor=#b45309;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="240" y="306" width="600" height="158" as="geometry"/></mxCell><mxCell value="merge：以 L = max(LSE(A), LSE(B)) 为 shift 基准" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#b45309;fontSize=13.5;fontColor=#b45309;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="240" y="306" width="600" height="30" as="geometry"/></mxCell><mxCell value="w(A) = e^(LSE(A)-L)      w(B) = e^(LSE(B)-L)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#7c5a1e;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="256" y="344" width="580" height="30" as="geometry"/></mxCell><mxCell value="alpha = w(A)/(w(A)+w(B))    beta = w(B)/(w(A)+w(B))" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#7c5a1e;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="256" y="378" width="580" height="30" as="geometry"/></mxCell><mxCell value="O = alpha * O(A) + beta * O(B)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#7c5a1e;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="256" y="412" width="580" height="30" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#b45309;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="540" y="470" as="sourcePoint"/><mxPoint x="540" y="496" as="targetPoint"/></mxGeometry></mxCell><mxCell value="O == softmax([s(1..n); s(n+1..n+m)]) 作用于 [V(A); V(B)] —— 与一次性 attention 逐元素相等" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=13;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="120" y="500" width="840" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>