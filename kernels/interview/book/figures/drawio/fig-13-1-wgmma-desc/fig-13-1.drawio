<mxfile host="app.diagrams.net"><diagram id="fig13-1" name="fig13-1"><mxGraphModel dx="800" dy="600" grid="0" page="1" pageWidth="1100" pageHeight="350" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell value="WGMMA smem descriptor：64-bit 位域（enc(x) = (x 和 0x3FFFF) 右移 4，18-bit 窗口 16B 对齐）" style="text;html=1;align=left;verticalAlign=middle;fontSize=15.5;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1050" height="26" as="geometry"/></mxCell><mxCell value="63-62 type 2b = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=10.5;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="66" width="86" height="84" as="geometry"/></mxCell><mxCell value="62-52 unused 10b" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=10.5;fontColor=#9aa5b1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="130" y="66" width="126" height="84" as="geometry"/></mxCell><mxCell value="51-49 base off 3b = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=10.5;fontColor=#d97706;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="260" y="66" width="106" height="84" as="geometry"/></mxCell><mxCell value="48-46 u 3b" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=10.5;fontColor=#9aa5b1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="370" y="66" width="66" height="84" as="geometry"/></mxCell><mxCell value="45-32 SBO enc 14b 1024 右移 4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=10.5;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="440" y="66" width="186" height="84" as="geometry"/></mxCell><mxCell value="31-30 u 2b" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=10.5;fontColor=#9aa5b1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="630" y="66" width="56" height="84" as="geometry"/></mxCell><mxCell value="30-16* LBO enc 14b 16 右移 4 = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=10.5;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="690" y="66" width="196" height="84" as="geometry"/></mxCell><mxCell value="15-14 u 2b" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=10.5;fontColor=#9aa5b1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="890" y="66" width="56" height="84" as="geometry"/></mxCell><mxCell value="13-0 addr enc 14b smem 右移 4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=10.5;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="950" y="66" width="186" height="84" as="geometry"/></mxCell><mxCell value="type=1（矩阵描述符）；u = unused；数值列为本章 kernel BK=64 half + 128B swizzle 取值" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="158" width="700" height="20" as="geometry"/></mxCell><mxCell value="swizzle 模式：0=none  1=128B  2=64B  3=32B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#2171b5;fontSize=12.5;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="196" width="500" height="34" as="geometry"/></mxCell><mxCell value="phase = (addr 右移 7) mod 8（1024B 边界）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#2171b5;fontSize=12.5;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="560" y="196" width="500" height="34" as="geometry"/></mxCell><mxCell value="SBO：8 行 stripe 间隔（K-major swizzle 布局）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#2e8540;fontSize=12.5;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="238" width="500" height="34" as="geometry"/></mxCell><mxCell value="LBO：K 方向 stride；base addr：绝对 smem 偏移" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#2e8540;fontSize=12.5;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="560" y="238" width="500" height="34" as="geometry"/></mxCell><mxCell value="对照 common.cuh L532-565 注释与 PTX ISA 9.7.15.5.1.2.2 逐字段核校；enc 取 16B 单位使 14b 编码覆盖 256KB smem 空间（18-bit 窗口 右移 4）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="30" y="292" width="1060" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>