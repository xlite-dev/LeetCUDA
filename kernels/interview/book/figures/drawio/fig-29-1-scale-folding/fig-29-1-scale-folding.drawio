t;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="480" width="608" height="20" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#dc2626;strokeWidth=2;rounded=0;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="975" y="340"/><mxPoint x="400" y="340"/></Array><mxPoint x="975" y="218" as="sourcePoint"/><mxPoint x="400" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell value="o_acc 全程单一 448× 域（fixed 统一域是 rescale 折进 FFMA 的前提）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="430" y="320" width="420" height="18" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6a51a3;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="700" y="400" width="436" height="120" as="geometry"/></mxCell><mxCell value="发射域纪律（三条硬约束）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6a51a3;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="716" y="408" width="404" height="20" as="geometry"/></mxCell><mxCell value="① lazy rescale 与满量程 P 互斥：2^T 膨胀撞 satfinite" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="716" y="432" width="404" height="20" as="geometry"/></mxCell><mxCell value="② f16 PV 累加域：kBc·448·2.25 ≤ 65504（kBc=128 时 P 收 224）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="716" y="456" width="404" height="20" as="geometry"/></mxCell><mxCell value="③ per-row p_s 满量程 ⟹ 无 2^T headroom ⟹ 与 ① 互斥" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="716" y="480" width="404" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="548" width="1112" height="62" as="geometry"/></mxCell><mxCell value="结论：除 Q/K/V/P 各自的 round() 外，无任何额外数学误差源——所有反量化都是精确代数操作" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1e5631;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="554" width="1072" height="22" as="geometry"/></mxCell><mxCell value="对照 ffpa-attn(861d75e)：fp8_pscale.cuh L72-300 三步协议 · persist_d.cuh Phase 1-5 · softmax.cuh L44-63" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="580" width="1072" height="20" as="geometry"/></mxCell><mxCell value="粒度 × scale 读取：per-block ks 每 tile 一标量；per-thread ks 按 lane%4 列组查 4 槽表、qs 按 {r,r+8} 行对查 64 槽表（零 shuffle）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="630" width="1112" height="20" as="geometry"/></mxCell><mxCell value="rowsum：tensor-core rowsum MMA（B 全 1）藏进 PV tensor pipe 气泡，CUDA-core FADD 版本实测 -4%" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="656" width="1112" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>