<mxfile host="app.diagrams.net"><diagram id="fig-28-2" name="fig-28-2"><mxGraphModel dx="800" dy="600" grid="0" page="1" pageWidth="1160" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell value="三条不变变换：改数值、保输出 —— outlier 处理的代数基础" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="8" width="1112" height="30" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="60" width="1112" height="168" as="geometry"/></mxCell><mxCell value="smooth-K（列均值平移）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6a51a3;fontSize=13;fontColor=#6a51a3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="36" y="72" width="176" height="34" as="geometry"/></mxCell><mxCell value="K&#39; = K − 1·k̄^T    （k̄ = 每列均值，逐行减同一向量）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="36" y="114" width="380" height="20" as="geometry"/></mxCell><mxCell value="S&#39; = QK&#39;^T = S − q_s·1^T   行内常数平移" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="36" y="138" width="380" height="20" as="geometry"/></mxCell><mxCell value="softmax(S&#39;) = softmax(S)：分子分母同乘 e^{q_s}" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="36" y="162" width="380" height="20" as="geometry"/></mxCell><mxCell value="⇒ P、O 逐 bit 不变" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1e5631;fontFamily=Helvetica;fontStyle=