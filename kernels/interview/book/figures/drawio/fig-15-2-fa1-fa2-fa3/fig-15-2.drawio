ry"/></mxCell><mxCell value="另加 CTA 级并行：grid.x = N/Br，沿 seqlen(Q) 喂饱 SM" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="620" y="236" width="476" height="24" as="geometry"/></mxCell><mxCell value="O 保持未归一化 -&gt; 尾部一次 diag(1/l)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="620" y="264" width="476" height="24" as="geometry"/></mxCell><mxCell value="FA3 (H100)：warp specialization + pingpong，softmax 与 GEMM 在不同运算单元上重叠" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=14;fontColor=#d97706;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="346" width="1072" height="32" as="geometry"/></mxCell><mxCell value="producer warp：TMA 异步提交（单线程）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#486581;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="386" width="300" height="30" as="geometry"/></mxCell><mxCell value="WG1 tensor" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#d97706;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="422" width="100" height="22" as="geometry"/></mxCell><mxCell value="GEMM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=11.5;fontColor=#d97706;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="108" y="420" width="175" height="26" as="geometry"/></mxCell><mxCell value="GEMM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=11.5;fontColor=#d97706;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="298" y="420" width="175" height="26" a