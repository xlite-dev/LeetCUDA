        <mxCell value="ffpa_split_d_cute (128 threads): dual TiledMma dataflow" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="12" width="840" height="24" as="geometry"/></mxCell><mxCell value="QK Tile&lt;64,64,16&gt; EURepeat&lt;1,8,1&gt; ｜ PV Tile&lt;64,16,16&gt; EURepeat&lt;1,2,1&gt; —— S 到 P 到 O 一条寄存器流水" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="30" y="38" width="840" height="20" as="geometry"/></mxCell><mxCell value="QK chunk 循环 (d = 0..C-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2171b5;strokeColor=#2171b5;fontSize=13.5;fontColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="80" width="240" height="30" as="geometry"/></mxCell><mxCell value="Q[d], K[d] --cp.async--&gt; smem" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bfd7ea;strokeColor=#2171b5;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="120" width="240" height="34" as="geometry"/></mxCell><mxCell value="S += Q[d] @ K[d]^T" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bfd7ea;strokeColor=#2171b5;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="162" width="240" height="34" as="geometry"/></mxCell><mxCell value="gemm_ss, 4 个 k16 原子" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bfd7ea;strokeColor=#2171b5;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="204" width="240" height="34" as="geometry"/></mxCell><mxCell value="S: 32 个 f32/线程 = ((2,2),1,8)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=12.5;fontColor=#2171b5;alig