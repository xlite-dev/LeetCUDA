<mxfile host="app.diagrams.net"><diagram id="fig-19-2" name="fig-19-2"><mxGraphModel dx="800" dy="600" grid="0" page="1" pageWidth="1120" pageHeight="596" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell value="跨 chunk 两阶段合并（C = 3，D = 192 示例）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1072" height="28" as="geometry"/></mxCell><mxCell value="stage 1：单个点积内部的精确归约（QK^T，无权重）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=14;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="48" width="1072" height="32" as="geometry"/></mxCell><mxCell value="S^(0) = Q0 K0^T" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="40" y="92" width="300" height="40" as="geometry"/></mxCell><mxCell value="S^(1) = Q1 K1^T" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="386" y="92" width="300" height="40" as="geometry"/></mxCell><mxCell value="S^(2) = Q2 K2^T" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="732" y="92" width="300" height="40" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#2171b5;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="190" y="134" as="sourcePoint"/><mxPoint x="420" y="168" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#2171b5;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="536" y="134" as="sourcePoint"/><mxPoint x="520" y="168" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#2171b5;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="882" y="134" as="sourcePoint"/><mxPoint x="620" y="168" as="targetPoint"/></mxGeometry></mxCell><mxCell value="acc += （mma.sync 链）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#2171b5;fontSize=13;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="320" y="170" width="480" height="40" as="geometry"/></mxCell><mxCell value="S[64,64] 完整 score tile（D-free）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=14;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="320" y="222" width="480" height="44" as="geometry"/></mxCell><mxCell value="stage 2：跨 KV tile 的 online softmax —— rho 必须广播到全部 C 个 acc" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=14;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="290" width="1072" height="32" as="geometry"/></mxCell><mxCell value="rho_t = exp(m_{t-1} - m_t)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=14;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="336" width="260" height="60" as="geometry"/></mxCell><mxCell value="O_0 *= rho_t；O_0 += exp(S-m_t) V_0（列 0..63）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=11.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="316" y="336" width="252" height="60" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#2e8540;strokeWidth=2;rounded=0;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="286" y="366" as="sourcePoint"/><mxPoint x="316" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell value="O_1 *= rho_t；O_1 += exp(S-m_t) V_1（列 64..127）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=11.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="580" y="336" width="252" height="60" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#2e8540;strokeWidth=2;rounded=0;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="286" y="366" as="sourcePoint"/><mxPoint x="580" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell value="O_2 *= rho_t；O_2 += exp(S-m_t) V_2（列 128..191）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=11.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="844" y="336" width="252" height="60" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#2e8540;strokeWidth=2;rounded=0;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="286" y="366" as="sourcePoint"/><mxPoint x="844" y="366" as="targetPoint"/></mxGeometry></mxCell><mxCell value="l_t = rho_t * l_{t-1} + rowsum(exp(S - m_t)) —— 每行全程只有一份 l" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="412" width="740" height="42" as="geometry"/></mxCell><mxCell value="最后一个 tile 后：O_c /= l_T（全部 c）-&gt; concat = 完整 softmax(QK^T/sqrt(D)) V" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#486581;fontSize=13;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="466" width="1072" height="42" as="geometry"/></mxCell><mxCell value="对比 split-KV（ch18）：需要第二次 max —— a = exp(m0-m)，b = exp(m1-m) 两套归并权重" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe3e3;strokeColor=#dc2626;fontSize=12;fontColor=#7f1d1d;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="524" width="526" height="56" as="geometry"/></mxCell><mxCell value="对比 split-D：无第二次 max —— rho 构造上被全部 chunk 共享（定理 eq:19-invariant 的不变量）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=12;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="570" y="524" width="526" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>