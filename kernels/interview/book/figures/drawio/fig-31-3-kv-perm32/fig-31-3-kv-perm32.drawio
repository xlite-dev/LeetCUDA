tColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="168" y="272" width="990" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="330" width="1110" height="440" as="geometry"/></mxCell><mxCell value="③ masking / bias 必须经 π 回到原始 token 位置判定" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="338" width="1070" height="22" as="geometry"/></mxCell><mxCell value="正确（perm-aware）:" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#2e8540;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="48" y="372" width="500" height="20" as="geometry"/></mxCell><mxCell value="smem 列 j" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9fb3c8;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="48" y="396" width="130" height="44" as="geometry"/></mxCell><mxCell value="pos = kv_tile·Bc&#10;+ kv_perm32(j)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6a51a3;fontSize=11;fontColor=#6a51a3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="218" y="396" width="170" height="44" as="geometry"/></mxCell><mxCell value="causal 判定&#10;pos ≤ q_row" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=11;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="422" y="396" width="130" height="44" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#102a43;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="178" y="418" as="sourcePoint"/><mxPoint x="218" y="418" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#102a43;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="388" y="418" as="sourcePoint"/><mxPoint x="422" y="418" as="targetPoint"/></mxGeometry></mxCell><mxCell value="S 的逻辑列 j 与 K 的存储列同步置换，语义列 = π(j)。&#10;attn_bias 同款：bias 列索引进 gmem/smem 读时过 π(j)。&#10;tile 级跳过（mask_start_tile / Tc_eff）不受影响：π 是窗口内双射。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="48" y="448" width="520" height="60" as="geometry"/></mxCell><mxCell value="错误（上游 SA3 的真实 bug）:" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="620" y="372" width="500" height="20" as="geometry"/></mxCell><mxCell value="smem 列 j" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9fb3c8;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="620" y="396" width="130" height="44" as="geometry"/></mxCell><mxCell value="直接用 j 当 token&#10;位置做判定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe5e5;strokeColor=#dc2626;fontSize=11;fontColor=#dc2626;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="790" y="396" width="170" height="44" as="geometry"/></mxCell><mxCell value="causal&#10;算错" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe5e5;strokeColor=#dc2626;fontSize=12;fontColor=#dc2626;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="994" y="396" width="118" height="44" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#102a43;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="750" y="418" as="sourcePoint"/><mxPoint x="790" y="418" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#102a43;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="960" y="418" as="sourcePoint"/><mxPoint x="994" y="418" as="targetPoint"/></mxGeometry></mxCell><mxCell value="置换只改存储位置，&#10;causal 边界在语义域：&#10;N=512 max_abs 3.3（量级错误）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#dc2626;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="620" y="448" width="500" height="60" as="geometry"/></mxCell><mxCell value="fragment 视角（为什么这张表能对齐布局）:" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="48" y="530" width="1070" height="20" as="geometry"/></mxCell><mxCell value="QK 后 S fragment&#10;线程 t 持逻辑列 (t%4)·2, (t%4)·2+1 …" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=11;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="48" y="556" width="330" height="66" as="geometry"/></mxCell><mxCell value="PV 的 A 操作数&#10;线程 t 需要 K 行 (t%4)·8 …（步长 8）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=11;fontColor=#8a4b08;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="424" y="556" width="330" height="66" as="geometry"/></mxCell><mxCell value="π 把步长-8 的取数&#10;变成连续存储列" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=11;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="800" y="556" width="234" height="66" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#102a43;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="378" y="589" as="sourcePoint"/><mxPoint x="424" y="589" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#102a43;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="754" y="589" as="sourcePoint"/><mxPoint x="800" y="589" as="targetPoint"/></mxGeometry></mxCell><mxCell value="同一张 π 表贯穿三处：量化写侧（load_token_id）、masking、attn_bias——单侧改动即静默错位。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="48" y="630" width="1070" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
