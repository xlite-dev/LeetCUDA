><mxCell value="e" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6a51a3;fontSize=13;fontColor=#6a51a3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="700" y="208" width="30" height="32" as="geometry"/></mxCell><mxCell value="e" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6a51a3;fontSize=13;fontColor=#6a51a3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="733" y="208" width="30" height="32" as="geometry"/></mxCell><mxCell value="e" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6a51a3;fontSize=13;fontColor=#6a51a3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="766" y="208" width="30" height="32" as="geometry"/></mxCell><mxCell value="e" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6a51a3;fontSize=13;fontColor=#6a51a3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="799" y="208" width="30" height="32" as="geometry"/></mxCell><mxCell value="m" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=13;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="832" y="208" width="30" height="32" as="geometry"/></mxCell><mxCell value="m" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=13;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="865" y="208" width="30" height="32" as="geometry"/></mxCell><mxCell value="m" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=13;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="898" y="208" width="30" height="32" as="geometry"/></mxCell><mxCell value="值域 [0, 448]；SF 自身舍入 6.25% 整体作用于 16 个元素" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="610" y="246" width="520" height="20" as="geometry"/></mxCell><mxCell value="MXFP4 对照：ue8m0/32 块，SF 步长 100%（未采用）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#9fb3c8;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="610" y="268" width="520" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="306" width="1106" height="440" as="geometry"/></mxCell><mxCell value="③ blockscale MMA：dequant 逐块隐含在乘法里（SM120 m16n32k64 mxf4nvf4）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="314" width="1070" height="22" as="geometry"/></mxCell><mxCell value="A&#770;（e2m1 数据）&#10;+ s_A（ue4m3，per-16）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=12;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="48" y="362" width="200" height="60" as="geometry"/></mxCell><mxCell value="B&#770;（e2m1 数据）&#10;+ s_B（ue4m3，per-16）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=12;fontColor=#8a4b08;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="48" y="462" width="200" height="60" as="geometry"/></mxCell><mxCell value="C（f32 累加器）&#10;S = QK 或 O = PV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=12;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="48" y="562" width="200" height="60" as="geometry"/></mxCell><mxCell value="blockscale MMA&#10;&#10;逐块 (A&#770;·s_A)(B&#770;·s_B)&#10;K=64 对齐 SF 旁路" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;fontSize=13;fontColor=#dc2626;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="330" y="426" width="220" height="130" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#2e8540;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="248" y="392" as="sourcePoint"/><mxPoint x="330" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#d97706;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="248" y="492" as="sourcePoint"/><mxPoint x="330" y="516" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#2171b5;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="550" y="491" as="sourcePoint"/><mxPoint x="248" y="592" as="targetPoint"/></mxGeometry></mxCell><mxCell value="块内视角（K 归约的每 16 一段）：" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="600" y="358" width="500" height="20" as="geometry"/></mxCell><mxCell value="acc += Σ&#8321;&#8326; (a&#770;&#7522;·s_A[blk]) · (b&#770;&#7522;·s_B[blk])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=13;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="600" y="382" width="480" height="46" as="geometry"/></mxCell><mxCell value="· 数据通路 4 bit，SF 旁路 8 bit，硬件在累加处乘回尺度" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="600" y="436" width="500" height="20" as="geometry"/></mxCell><mxCell value="· K 维必须 64 对齐（SF atom 64 宽）→ D pad 到 64 倍数" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="600" y="458" width="500" height="20" as="geometry"/></mxCell><mxCell value="· pad 列 data=0 且 SF=0 → 贡献恒 0（不产垃圾）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="600" y="480" width="500" height="20" as="geometry"/></mxCell><mxCell value="· SF 编码误差 = 尺度级错误：写序必须 match SF atom" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="600" y="502" width="500" height="20" as="geometry"/></mxCell><mxCell value="让 e2m1 可用的尺度工程（本章内容）：" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="600" y="536" width="500" height="20" as="geometry"/></mxCell><mxCell value="microscaling&#10;1×16 块 + ue4m3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1eaf8;strokeColor=#6a51a3;fontSize=11;fontColor=#6a51a3;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="600" y="560" width="150" height="46" as="geometry"/></mxCell><mxCell value="smoothing&#10;q_m / k&#772; 强制减除" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=11;fontColor=#2e8540;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="770" y="560" width="150" height="46" as="geometry"/></mxCell><mxCell value="hadamard&#10;通道摊平（fused）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=11;fontColor=#8a4b08;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="940" y="560" width="140" height="46" as="geometry"/></mxCell><mxCell value="均值走 fp32 精确旁路（ΔS / lse / epilogue 加回），" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="600" y="612" width="500" height="20" as="geometry"/></mxCell><mxCell value="残差交给 e2m1 —— 量化预算全部留给有效信息" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="600" y="632" width="500" height="20" as="geometry"/></mxCell><mxCell value="P 的困难（online、值域 [0,1]、行内分布剧变）→ 两级 P 量化，见下一章" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a51a3;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="646" width="540" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
