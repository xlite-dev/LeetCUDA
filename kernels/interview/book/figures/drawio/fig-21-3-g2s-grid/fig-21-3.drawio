gn=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="618" y="398" width="518" height="44" as="geometry"/></mxCell><mxCell value="对照 S2R 拷贝：Tiler = (32,16) 无全覆盖，P*V = 1024 -&gt; 2x 重复（N 方向 warp 重读同一 A，eq. 21-dup）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe3e3;strokeColor=#dc2626;fontSize=13;fontColor=#7f1d1d;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="452" width="1112" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>