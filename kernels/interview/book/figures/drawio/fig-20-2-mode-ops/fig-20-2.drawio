<mxfile host="app.diagrams.net"><diagram id="fig-20-2" name="fig-20-2"><mxGraphModel dx="800" dy="600" grid="0" page="1" pageWidth="1160" pageHeight="384" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell value="mode 树与四种 mode 操作（Lg = ((2,4),(3,2)):((1,2),(8,24))）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1112" height="28" as="geometry"/></mxCell><mxCell value="Lg 根节点（rank-2 嵌套布局）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9e2ec;strokeColor=#486581;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="60" width="300" height="44" as="geometry"/></mxCell><mxCell value="mode0 = (2,4):(1,2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=12.5;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="140" width="180" height="44" as="geometry"/></mxCell><mxCell value="mode1 = (3,2):(8,24)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=12.5;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="216" y="140" width="180" height="44" as="geometry"/></mxCell><mxCell value="" style="endArrow=none;html=1;strokeColor=#486581;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="150" y="104" as="sourcePoint"/><mxPoint x="114" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=none;html=1;strokeColor=#486581;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array><mxPoint x="270" y="104" as="sourcePoint"/><mxPoint x="306" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell value="mode0：2 元素 stride 1，4 元素 stride 2" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="192" width="380" height="20" as="geometry"/></mxCell><mxCell value="mode1：3 元素 stride 8，2 元素 stride 24" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="214" width="380" height="20" as="geometry"/></mxCell><mxCell value="四种 mode 操作（结果 shape:stride）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9e2ec;strokeColor=#486581;fontSize=13.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="470" y="56" width="666" height="32" as="geometry"/></mxCell><mxCell value="projection：layout&lt;0&gt;(Lg) = (2,4):(1,2)；layout&lt;1&gt;(Lg) = (3,2):(8,24)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=12.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="470" y="96" width="666" height="40" as="geometry"/></mxCell><mxCell value="merge：group&lt;0,2&gt;(Lg) = ((2,4),(3,2)):((1,2),(8,24))（rank-1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8540;fontSize=12.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="470" y="144" width="666" height="40" as="geometry"/></mxCell><mxCell value="flatten：Lg = (2,4,3,2):(1,2,8,24)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontSize=12.5;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="470" y="192" width="666" height="40" as="geometry"/></mxCell><mxCell value="coalesce：Lg = (48):(1) —— 一段连续 48 格" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=13;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="470" y="240" width="666" height="44" as="geometry"/></mxCell><mxCell value="strides 链式衔接：1 -&gt; 2 -&gt; 8 -&gt; 24（2 = 1*2，8 = 2*4，24 = 8*3），编译期消除冗余 mode" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="470" y="292" width="666" height="22" as="geometry"/></mxCell><mxCell value="kernel 里「fragment mode 与 rest mode 分离」就是一次投影；合并/展平把嵌套结构变成可直接索引的线性结构" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=13;fontColor=#7c3a06;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="24" y="330" width="1112" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>