<mxfile host="app.diagrams.net"><diagram id="fig12-3" name="fig12-3"><mxGraphModel dx="800" dy="600" grid="0" page="1" pageWidth="1100" pageHeight="450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell value="XOR swizzle 位运算：Swizzle=B,M,S（fp16 tile 字节偏移）" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="26" as="geometry"/></mxCell><mxCell value="BK=16 tile 字节偏移 a = 32*i + 16*c + w 的 bit 布局：" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50" y="56" width="700" height="20" as="geometry"/></mxCell><mxCell value="bit 9-7: i（行）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=12;fontColor=#2171b5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="84" width="240" height="40" as="geometry"/></mxCell><mxCell value="bit 6-5: ..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=12;fontColor=#9aa5b1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="304" y="84" width="180" height="40" as="geometry"/></mxCell><mxCell value="bit 4: c（chunk）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d0;strokeColor=#d97706;fontSize=12;fontColor=#d97706;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="488" y="84" width="200" height="40" as="geometry"/></mxCell><mxCell value="bit 3-0: w（chunk 内）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=12;fontColor=#9aa5b1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="692" y="84" width="260" height="40" as="geometry"/></mxCell><mxCell value="行号从 bit5 起 -> bit7 = (i 右移 2 且 mod 2) 是 XOR 源位；chunk 位 bit4 是 XOR 目标位" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="60" y="132" width="900" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="60" y="164" width="460" height="60" as="geometry"/></mxCell><mxCell value="apply(a) = a ^ ((a 和 0x80) 右移 3)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#2171b5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="74" y="170" width="440" height="22" as="geometry"/></mxCell><mxCell value="= a ^ (bit7(a) 左移 4)   // bit4 异或 bit7（B=1,M=4,S=3）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#243b53;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="74" y="194" width="440" height="22" as="geometry"/></mxCell><mxCell value="行宽决定「多少行号位能挤进 bank 位 [2,7)」-> 最小冲突度：" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50" y="244" width="700" height="20" as="geometry"/></mxCell><mxCell value="32B 行（BK=16）：bit4=c，bit7=row 右移 2 -> 可达 1-way" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=12.5;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="272" width="980" height="34" as="geometry"/></mxCell><mxCell value="128B 行（BK=64）：a = 128i+32s+16c+w，bits [i:7..][s:5-6][c:4][w:0-3]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f6fb;strokeColor=#2171b5;fontSize=12.5;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="60" y="312" width="980" height="34" as="geometry"/></mxCell><mxCell value="per-slice swizzle 小于 16：仅 bit4 异或 bit7 -> 2 quad/phase = 4-way" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2171b5;fontSize=12;fontColor=#243b53;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="60" y="352" width="480" height="34" as="geometry"/></mxCell><mxCell value="全宽 swizzle 小于 64（B=3）：bits 4-6 异或 bits 7-9 -> 8 quad = 1-way" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c9e4c8;strokeColor=#2e8540;fontSize=12;fontColor=#1e5631;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="560" y="352" width="480" height="34" as="geometry"/></mxCell><mxCell value="源位域 [M+S, M+S+B) 与目标位域 [M, M+B) 不相交（S 不小于 B）-> 两次应用复原：对合（引理 12.1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e7ecf3;strokeColor=#2171b5;fontSize=12.5;fontColor=#102a43;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="398" width="980" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>