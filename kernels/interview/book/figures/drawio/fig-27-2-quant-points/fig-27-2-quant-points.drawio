olor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="572" y="42" width="552" height="20" as="geometry"/></mxCell><mxCell value="per-thread 粒度与 mma fragment 对齐 → scale 零 shuffle 使用" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="572" y="64" width="552" height="20" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#6a51a3;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="118"/></Array><mxPoint x="480" y="118" as="sourcePoint"/><mxPoint x="640" y="138" as="targetPoint"/></mxGeometry></mxCell><mxCell value="s_dequant = scale·δ_Q·δ_K·log2 e（单个 fp32）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6a51a3;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="190" y="88" width="360" height="20" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#2171b5;strokeWidth=2;rounded=0;dashed=0" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="266"/></Array><mxPoint x="890" y="266" as="sourcePoint"/><mxPoint x="770" y="202" as="targetPoint"/></mxGeometry></mxCell><mxCell value="v_s 折进 P 发射：P̃ = P·v_s·448" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#2171b5;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="470" y="240" width="400" height="20" as="geometry"/></mxCell><mxCell value="(P·v_s/p_s)·(V/v_s) = PV/p_s —— v_s 精确消去" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="470" y="262" width="410" height="20" as="geometry"/></mxCell><mxCell value="量化点 3（离线）：V → e4m3（per-channel）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#102a43;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="830" y="296" width="310" height="20" as="geometry"/></mxCell><mxCell value="V̂ = V/v_s 驻留 gmem，原样复用" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="830" y="318" width="310" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe5e5;strokeColor=#dc2626;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="330" width="520" height="112" as="geometry"/></mxCell><mxCell value="量化点 2（在线）：P 每 tile 重算 → 无法离线" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#dc2626;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="38" y="338" width="492" height="20" as="geometry"/></mxCell><mxCell value="fixed：p_s ≡ 1/448（编译期常数），o_acc 单一域直接累加；" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="360" width="492" height="20" as="geometry"/></mxCell><mxCell value="epilogue 一步 O = o_acc·(1/448)/ℓ 完成反量化+归一化" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="382" width="492" height="20" as="geometry"/></mxCell><mxCell value="per-row：p_s[row] = rowmax(P)/448，满量程精度最优（费寄存器）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#48586a;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="38" y="404" width="492" height="20" as="geometry"/></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#dc2626;strokeWidth=2;rounded=0;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="330"/></Array><mxPoint x="770" y="202" as="sourcePoint"/><mxPoint x="548" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#d97706;strokeWidth=2;rounded=0;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1035" y="228"/><mxPoint x="1098" y="228"/></Array><mxPoint x="1035" y="202" as="sourcePoint"/><mxPoint x="1098" y="202" as="targetPoint"/></mxGeometry></mxCell><mxCell value="p_s 收尾：O += MMA·p_s（fixed：并入 epilogue 常数）" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#d97706;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="620" y="206" width="400" height="20" as="geometry"/></mxCell><mxCell value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#9fb3c8;fontSize=13;fontColor=#1f2933;align=center;verticalAlign=middle;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="470" width="1112" height="96" as="geometry"/></mxCell><mxCell value="要点 1：δ_Qδ_K 折进 exp2 系数（softmax 前一次乘入，kMaxScaleAfter 再省 B_c 次 FMUL）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="478" width="1072" height="22" as="geometry"/></mxCell><mxCell value="要点 2：v_s 在 P 侧精确消去 → gmem 的 V̂ 不动；p_s 只在 epilogue 出现一次" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#102a43;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="44" y="502" width="1072" height="22" as="geometry"/></mxCell><mxCell value="结论：除量化本身 round() 外无任何额外数学误差源——所有反量化都是精确代数操作" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1e5631;fontFamily=Helvetica;fontStyle=1" vertex="1" parent="1"><mxGeometry x="44" y="526" width="1072" height="22" as="geometry"/></mxCell><mxCell value="溢出约束（fixed + FA-4 lazy rescale）：2^T · amax(V) ≤ 448，T=4 ⇒ amax(V) ≤ 28，残余超调 satfinite 兜底" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#dc2626;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="580" width="1112" height="20" as="geometry"/></mxCell><mxCell value="互斥约束：per-row 满量程发射没有 2^T headroom —— per-row 与 lazy rescale 不能同时开" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#dc2626;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="604" width="1112" height="20" as="geometry"/></mxCell><mxCell value="对照 ffpa-attn：cute/fp8/fp8_pscale.cuh L17-37（三步协议）；kernel 化展开见 ch29（persist-D）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#627d98;fontFamily=Helvetica" vertex="1" parent="1"><mxGeometry x="24" y="648" width="1112" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>